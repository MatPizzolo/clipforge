# Copy to .env.local for local dev. Never commit .env.local.
# Serve fixtures instead of calling the API (local dev, CI and Vercel previews; refused in production).
MOCK_API=1
# Deployed job API (the Modal `web` endpoint) and its bearer token (same as clipforge-secrets API_TOKEN).
CLIPFORGE_API_URL=
API_TOKEN=
# Turn the GitHub login off for LOCAL testing only. Never on Vercel (refused there):
# previews use MOCK_API=1, production uses GitHub login.
# AUTH_DISABLED=1
# Auth.js: `npx auth secret` prints one. A session ends after 7 days without use; rotating it logs everyone out.
AUTH_SECRET=
# GitHub OAuth app id/secret. Locally, use the SECOND OAuth app (the owner's local one):
#   Homepage URL http://localhost:3000, callback http://localhost:3000/api/auth/callback/github.
# Vercel uses the production app (callback https://<domain>/api/auth/callback/github).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# The one GitHub account allowed in (its primary, verified email).
OWNER_EMAIL=

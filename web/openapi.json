    "/posting/rebuild": {
      "post": {
        "operationId": "post_posting_rebuild_posting_rebuild_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"

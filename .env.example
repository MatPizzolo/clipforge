# Copy to .env and fill in. Never commit a filled-in .env.
# In production these values live in the Modal secret `clipforge-secrets` (ADR-9).
# Keep comments on their own lines: python-dotenv reads `KEY=  # note` as the value "# note".
# Generate random values with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Secrets
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Random string; Telegram sends it back in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user ids; the bot ignores everyone else.
TELEGRAM_ALLOWED_USER_IDS=
# Bearer token for the job API (CLI and curl).
API_TOKEN=
# Signs zip download links (HMAC-SHA256).
DOWNLOAD_SIGNING_KEY=

# --- Deployed API (printed by `modal deploy`; used by the CLI and in download links)
# The web URL printed by modal deploy, e.g. https://<workspace>--clipforge-web.modal.run
API_URL=
DOWNLOAD_LINK_TTL_S=604800

# --- Models
HIGHLIGHT_MODEL=claude-haiku-4-5
WHISPER_MODEL=large-v3-turbo
MODAL_APP_NAME=clipforge

# --- Job defaults
# auto = every candidate scoring at least DEFAULT_MIN_SCORE (at most 30), or a fixed number
DEFAULT_CLIP_COUNT=auto
DEFAULT_MIN_SCORE=0.80
DEFAULT_CLIP_LEN=30-60
# own | creator_agreement | clipping_program | cc_by | public_domain (see docs/SOURCING.md)
DEFAULT_PERMISSION=own

# --- Limits (checked before any GPU time)
MAX_SOURCE_DURATION_S=10800
MAX_SOURCE_BYTES=4000000000

# --- Storage: the Modal Volume mount
JOBS_ROOT=/jobs

# The dashboard's address (ADR-44): bot messages get "Job ↗" / "Source ↗" / "Account ↗" buttons
# to its pages. Unset = no buttons.
DASHBOARD_URL=
# Ops alerts (ADR-45) go to POSTING_CHAT_ID, else the first TELEGRAM_ALLOWED_USER_IDS; quiet
# hours 23:00-08:00 in this time zone (unset = POSTING_TIMEZONE)
OWNER_TIMEZONE=

# Posting assistant (ADR-23): the bot sends clips here at each slot; unset = off
POSTING_CHAT_ID=
POSTING_TIMEZONE=America/New_York
POSTING_SLOTS=08:00,10:30,13:00,16:00,19:00,21:30
POSTING_HASHTAGS=

# Durable state (S1, ADR-26/41). Neon's pooled URL (host has -pooler) for the app; the direct
# URL for Alembic migrations, which never fall back to the pooled one.
# Not in clipforge-secrets until S1 rollout step 4c.2 (decision log #107).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Which store posting reads: dict (default, rollback) or postgres. Anything else reads the
# Dict and turns posting off with the reason in /status and an ops alert (card 039)
STATE_READS=dict
# In STATE_READS=dict mode, the POSTING_* settings above describe this account
POSTING_ACCOUNT_ID=realtalk-clips-en
# Read only by scripts/deploy.sh (card 008, decision log #391): on = refuse to deploy while the
# database (read-only through DATABASE_URL_UNPOOLED) is behind the code's newest migration.
# off until S1 rollout step 4c.2, then on. Not in clipforge-secrets.
DEPLOY_DB_CHECK=off

# --- S2 (publishing and autopilot). None is needed for S2a: leave them unset.
# The policy gate (S2 spec §5.1): off = it only logs (S2a). Turn on in S2b only after
# `clipforge policy dry-run` reports "0 items would be held" (decision log #461).
# GATE_ENFORCE=false
# Upload-Post (S2b, card 015): both optional; without them publishing is off and its webhook
# answers 503. Secrets: add them with docs/ops/secrets.md's dashboard procedure.
# UPLOAD_POST_API_KEY=
# UPLOAD_POST_WEBHOOK_SECRET=
# UPLOAD_POST_URL=https://api.upload-post.com
# Signed media links Upload-Post fetches (seconds)
# MEDIA_LINK_TTL_S=86400
# Crash recovery's re-send window (seconds): 0 = never re-send, until R5 confirms key retention
# RECOVERY_WINDOW_S=0
# Basic covers 5 profiles; connecting more warns (upgrade at the 6th, O4)
# UPLOAD_POST_PROFILE_LIMIT=5
